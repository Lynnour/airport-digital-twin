		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1785574422331">
			<Id>1788343939174</Id>
			<Name><![CDATA[MonteCarlo]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[traceln("CheckIn,Security,Passport,Gate,AirportTime,WaitingTime,StaffingCost,WaitingCost,TotalCost,TotalArrivals,CompletedPassengers,RemainingPassengers");]]></InitialSetupCode>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[root.unfinishedWaitingTime = 0;


// Passengers waiting in the separate Check-In queue
for (int i = 0; i < root.CheckInQueue.size(); i++) {
    Passenger p = (Passenger) root.CheckInQueue.get(i);
    root.unfinishedWaitingTime += root.time() - p.checkInStart;
}

// Passengers waiting in the separate Security queue
for (int i = 0; i < root.SecurityQueue.size(); i++) {
    Passenger p = (Passenger) root.SecurityQueue.get(i);
    root.unfinishedWaitingTime += root.time() - p.securityStart;
}

// Passengers waiting in the separate Passport queue
for (int i = 0; i < root.PassportQueue.size(); i++) {
    Passenger p = (Passenger) root.PassportQueue.get(i);
    root.unfinishedWaitingTime += root.time() - p.passportStart;
}

// Passengers waiting in the separate Boarding queue
for (int i = 0; i < root.BoardingQueue.size(); i++) {
    Passenger p = (Passenger) root.BoardingQueue.get(i);
    root.unfinishedWaitingTime += root.time() - p.boardingStart;
}

// Passengers waiting inside SecurityScreening
for (Passenger p : root.securityWaitingList) {
    root.unfinishedWaitingTime += root.time() - p.securityStart;
}

// Passengers waiting inside CheckInService
for (Passenger p : root.checkInWaitingList) {
    root.unfinishedWaitingTime += root.time() - p.checkInStart;
}

// Passengers waiting inside PassportControl
for (Passenger p : root.passportWaitingList) {
    root.unfinishedWaitingTime += root.time() - p.passportStart;
}

// Passengers waiting inside BoardingService
for (Passenger p : root.boardingWaitingList) {
    root.unfinishedWaitingTime += root.time() - p.boardingStart;
}
// Remaining passengers
int remaining = root.totalArrivals - root.completedPassengers;


// Waiting cost
root.waitingCost =
    (root.totalWaitingTimeSum + root.unfinishedWaitingTime)
    * root.waitingCostPerPassengerMinute;

// Total operating cost
root.totalOperatingCost =
    root.staffingCost + root.waitingCost;

// Export simulation results
traceln(
    root.numcheckInAgents + "," +
    root.numSecurityOfficers + "," +
    root.numPassportOfficers + "," +
    root.numGateAgents + "," +
    (root.completedPassengers > 0
        ? root.totalTimeSum / root.completedPassengers : 0) + "," +
    (root.totalArrivals > 0
    ? (root.totalWaitingTimeSum + root.unfinishedWaitingTime)
        / root.totalArrivals : 0) + "," +
    root.staffingCost + "," +
    root.waitingCost + "," +
    root.totalOperatingCost + "," +
    root.totalArrivals + "," +
    root.completedPassengers + "," +
    remaining
);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
