					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Passenger p = (Passenger) agent;

p.departureTime = time();
p.totalAirportTime = p.departureTime - p.arrivalTime;

totalTimeSum += p.totalAirportTime;
completedPassengers++;

agent.totalWaitingTime =
    agent.checkInWaitingTime +
    agent.securityWaitingTime +
    agent.passportWaitingTime +
    agent.boardingWaitingTime;

completedWaitingTimeSum += agent.totalWaitingTime;


waitingPassengers++;

staffingCost = 8 * (
    numcheckInAgents * checkInCostPerHour +
    numSecurityOfficers * securityCostPerHour +
    numPassportOfficers * passportCostPerHour +
    numGateAgents * gateCostPerHour
);
CompletedPassengers++;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destroyEntity]]></Name>
						</Parameter>
					</Parameters>
